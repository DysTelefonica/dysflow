{
  "description": "Dysflow lifecycle hooks for Codex — same shape as Claude Code plugin but with Codex-specific env var substitution. Mirrors engram's plugin/codex/hooks/hooks.json layout namespaced under 'dysflow'.",
  "_dysflow_marker": "DO NOT EDIT MANUALLY — replaced on plugin update. See plugin/claude-code/hooks/hooks.json for the parallel Claude Code version.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "[dysflow-plugin] Loading canonical workflow + project state..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/scripts/post-compaction.sh\"",
            "timeout": 10,
            "statusMessage": "[dysflow-plugin] Re-establishing context after compaction..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/scripts/user-prompt-submit.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/scripts/subagent-stop.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/scripts/session-stop.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
