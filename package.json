{
  "name": "dysflow",
  "version": "4.2.0",
  "description": "Dysflow Access automation product foundation.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "dysflow": "./dist/cli/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:public": "vitest run -c vitest.public.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e:mcp": "node E2E_testing/mcp-e2e.mjs",
    "test:e2e:mcp:resume": "node E2E_testing/mcp-e2e.mjs --resume",
    "test:e2e:mcp:release": "node E2E_testing/mcp-e2e.mjs --release",
    "test:ps1": "pwsh -Command \"Invoke-Pester scripts/tests/\"",
    "build": "tsc -p tsconfig.json",
    "mcp:context-budget": "node scripts/mcp-context-budget.mjs --baseline scripts/baselines/mcp-context-budget.json",
    "lint": "node scripts/check-core-adapter-boundary.mjs && node scripts/check-optional-presence-guards.mjs && node scripts/report-ts-import-cycles.mjs --check scripts/baselines/ts-import-cycles.json && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && biome check src/ test/ tests/ scripts/ E2E_testing/",
    "lint:fix": "biome check src/ test/ tests/ scripts/ E2E_testing/ --write",
    "format": "biome format src/ test/ tests/ scripts/ E2E_testing/ --write",
    "format:check": "biome format src/ test/ tests/ scripts/ E2E_testing/",
    "coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "~26.2.0",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.15": ">=1.19.15",
      "esbuild@<0.28.1": ">=0.28.1",
      "fast-uri@<3.1.3": ">=3.1.3",
      "fast-uri@>=4.0.0 <4.1.2": ">=4.1.2",
      "hono@<4.12.34": ">=4.12.34",
      "ip-address@<=10.3.0": ">=10.3.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<8.5.23": ">=8.5.23"
    }
  }
}
